{
  "name": "turkish-profile",
  "version": "3.0.1",
  "private": false,
  "description": "Random Turkish name generator with realistic probabilities",
  "keywords": [
    "turkish",
    "turkish-name",
    "turkish-names",
    "turkish-first-name",
    "turkish-last-name",
    "turkish-surname",
    "turkish-profile",
    "name-generator",
    "profile-generator",
    "password-generator",
    "random-name",
    "fake-name",
    "random-profile",
    "fake-profile",
    "secure-password",
    "random-password",
    "seedable",
    "deterministic",
    "reproducible",
    "faker",
    "mock-data",
    "türkçe",
    "isim",
    "ad",
    "soyad",
    "şifre"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahelbir/turkish-profile.git"
  },
  "license": "MIT",
  "author": "Mahmuthan Elbir",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*",
    "resources/*"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "node --test",
    "prepublishOnly": "npm run build && npm test",
    "relock": "rm -rf node_modules package-lock.json && NODE_ENV= npm install --include=dev --include=optional"
  },
  "devDependencies": {
    "tsdown": "^0.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
